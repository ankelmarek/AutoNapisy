{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "media",
    "segments",
    "styles",
    "createdAt",
    "updatedAt",
    "clips"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "media": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "name",
            "duration"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "duration": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "start",
          "end",
          "words",
          "styleId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start",
                "end"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "styleId": {
            "type": "string"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fontFamily",
          "fontSize",
          "color",
          "background",
          "position"
        ],
        "properties": {
          "fontFamily": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "fontSize": {
            "type": "number",
            "minimum": 12,
            "maximum": 100
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "background": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "position": {
            "enum": [
              "bottom",
              "center",
              "top"
            ]
          },
          "uppercase": {
            "type": "boolean",
            "default": false
          },
          "maxLines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2
          },
          "charsPerLine": {
            "type": "integer",
            "minimum": 12,
            "maximum": 48,
            "default": 24
          },
          "wordsPerCard": {
            "type": "integer",
            "minimum": 3,
            "maximum": 16,
            "default": 8
          },
          "boxWidth": {
            "type": "number",
            "minimum": 40,
            "maximum": 95,
            "default": 84
          },
          "cornerRadius": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 10
          },
          "marginPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "default": 8
          },
          "effect": {
            "enum": [
              "box",
              "outline",
              "highlight"
            ]
          },
          "outlineColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "outlineWidth": {
            "type": "number",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "clips": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourceIn",
              "sourceOut",
              "start"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceIn": {
                "type": "number",
                "minimum": 0
              },
              "sourceOut": {
                "type": "number",
                "minimum": 0
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "assetId": {
                "type": "string",
                "description": "Brak oznacza główne media"
              },
              "track": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ],
                "default": 0
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "audio"
                ],
                "default": "video"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "adjustments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "brightness",
                  "contrast",
                  "saturation"
                ],
                "properties": {
                  "brightness": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 2
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 2
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              }
            }
          }
        }
      ]
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "name",
          "duration",
          "kind",
          "segments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.05
          },
          "kind": {
            "enum": [
              "video",
              "audio"
            ]
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "start",
                "end",
                "words",
                "styleId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start",
                      "end"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                },
                "styleId": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "captionEdits": {
      "type": "object",
      "maxProperties": 10000,
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trimStart",
          "trimEnd"
        ],
        "properties": {
          "trimStart": {
            "type": "number",
            "minimum": 0
          },
          "trimEnd": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 99,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromId",
          "toId",
          "kind",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fromId": {
            "type": "string",
            "minLength": 1
          },
          "toId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fade",
              "fadeblack",
              "fadewhite",
              "slideleft",
              "slideright",
              "slideup",
              "slidedown",
              "wipeleft",
              "wiperight",
              "wipeup",
              "wipedown",
              "hblur",
              "pixelize",
              "circleopen",
              "rectcrop",
              "distance",
              "dissolve",
              "zoomin",
              "diagtl",
              "horzopen"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2
          }
        }
      }
    },
    "timelineSegments": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "start",
              "end",
              "words",
              "styleId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "styleId": {
                "type": "string"
              }
            }
          }
        }
      ],
      "default": null
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolvixa:project:6",
  "title": "RolVixa project v6",
  "$comment": "Czasy w sekundach. Walidatory aplikacji dodatkowo sprawdzają relacje czasów, unikalność ID i referencje stylów.",
  "description": "Napisy montażu w czasach osi, przejścia FFmpeg xfade. Migracja v5 zachowuje długości i zamienia left/right/black na slideleft/slideright/fadeblack."
}
